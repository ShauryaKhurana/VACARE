# Copy this file to .env and fill in the values.
# .env is gitignored; this example file is committed as documentation.
#
# Deploy: this is the only required secret. Render's deploy button prompts
# for it; locally, `docker compose up` reads it from this file.

# Google Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# VA Lighthouse APIs — https://developer.va.gov
# Use mock responses until sandbox keys are configured.
VA_USE_MOCK=true
VA_API_KEY=
VA_API_BASE_URL=https://sandbox-api.va.gov/services/vba_documents/v1
VA_SANDBOX_FILE_NUMBER=000000000
VA_SANDBOX_ZIP=20500
VA_INTAKE_SOURCE=VACARE

# Reuse a stored parse when the same file is uploaded again.
# Off by default: every upload is read afresh, which costs an API call
# but means a document is never stuck with an older interpretation.
# VACARE_PARSE_CACHE=1
